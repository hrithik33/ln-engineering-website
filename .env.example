# ==============================================================================
# LN Engineering — Environment Configuration Template
# Copy this file to .env.local for local development or set in production hosting
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMTP Email Delivery (Optional but Recommended for Live Sales Dispatch)
# When configured, inquiries submitted through the quotation form are automatically
# emailed to the factory sales team in real-time.
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="sales@gangsawmachines.com"
SMTP_PASS="your_secure_smtp_password"
SMTP_FROM="\"LN Engineering Web Inquiries\" <sales@gangsawmachines.com>"

# Recipients for new incoming quotation leads (comma separated)
SALES_EMAIL_RECIPIENT="info@gangsawmachines.com, lnrajsamand@gmail.com"

# ------------------------------------------------------------------------------
# 2. CRM / Webhook Notification (Optional)
# If provided, leads will be forwarded via HTTP POST JSON to this endpoint
# (e.g. Zapier, Make, Slack Incoming Webhook, or internal ERP system)
# ------------------------------------------------------------------------------
WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# ------------------------------------------------------------------------------
# 3. Base Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.gangsawmachines.com"
