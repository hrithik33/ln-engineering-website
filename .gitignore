# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# persistent local leads storage (prevent committing customer PII)
data/*.jsonl
!data/.gitkeep


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large raw archives exceeding GitHub 100MB limit (optimized version is included)
public/documents/ln-engineering-catalogue.pdf
